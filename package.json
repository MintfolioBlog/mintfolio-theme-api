{
  "name": "@mintfolio/theme-api",
  "version": "1.4.1",
  "description": "Public types, manifests and content contracts for Mintfolio themes.",
  "type": "module",
  "files": [
    "dist",
    "src/SeoHead.astro",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./SeoHead.astro": "./src/SeoHead.astro",
    "./protected-article": {
      "types": "./dist/protectedArticle.d.ts",
      "import": "./dist/protectedArticle.js"
    }
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "check": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "dompurify": "^3.4.16"
  },
  "peerDependencies": {
    "astro": "^7.3.2"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "license": "GPL-3.0-only",
  "author": "CNFLWZH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintfolioBlog/mintfolio-theme-api.git"
  },
  "homepage": "https://github.com/MintfolioBlog/mintfolio-theme-api#readme",
  "bugs": {
    "url": "https://github.com/MintfolioBlog/mintfolio-theme-api/issues"
  }
}
