{
  "name": "@mintfolio/theme-api",
  "version": "1.0.0",
  "description": "Public, layout-independent contracts and helpers for Mintfolio themes",
  "type": "module",
  "files": [
    "dist",
    "src/SeoHead.astro",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./SeoHead.astro": "./src/SeoHead.astro"
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "check": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15"
  },
  "peerDependencies": {
    "astro": "^7.3.2"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
